# Copy to .env and fill in one provider. The first endpoint in configs/models.yaml
# whose key is set is used, unless `factory generate --model <name>` picks one.

# Anthropic Messages API (or a server compatible with it)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI or any OpenAI-compatible server (vLLM, Ollama, OpenRouter, a gateway, ...)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-server.example.com/v1
# OPENAI_MODEL=your-model-name

# LOCAL_LLM_API_KEY=anything   # the local endpoint needs any non-empty value
